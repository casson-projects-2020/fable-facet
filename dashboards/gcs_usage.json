{
    "displayName": "Fable Facet GCS Storage usage",
    "dashboardFilters": [],
    "description": "",
    "labels": 
    {   "dashboard_storage_for": "fablefacet"   },
    "mosaicLayout": 
    {   "columns": 48,
        "tiles": 
        [{
            "height": 16,
            "width": 16,
            "widget": 
            {   "title": "Fable Facet GCS Class A Ops (lim 5.000) {date_placeholder}",   "id": "",
                "scorecard": 
                {   "breakdowns": [],
                    "dimensions": [],
                    "gaugeView": 
                    {   "lowerBound": 0,
                        "upperBound": 5000
                    },
                    "measures": [],
                    "thresholds": [],
                    "timeSeriesQuery": 
                    {   "outputFullDuration": true,
                        "timeSeriesFilter": 
                        {   "aggregation": 
                            {   "alignmentPeriod": "86400s",
                                "crossSeriesReducer": "REDUCE_SUM",
                                "groupByFields": [],
                                "perSeriesAligner": "ALIGN_SUM"
                            },
                            "filter": "metric.type=\"logging.googleapis.com/user/operations_gcs_fablefacet\" metric.label.\"operation_class\"=\"CLASS_A\" metric.label.\"month\"=\"2606\""
                        },
                        "unitOverride": ""
                    }
                }
            }
        },{
            "xPos": 16,
            "height": 16,
            "width": 17,
            "widget": 
            {   "title": "Fable Facet GCS Class B Ops (lim 50.000) {date_placeholder}",   "id": "",
                "scorecard": 
                {   "breakdowns": [],
                    "dimensions": [],
                    "gaugeView": 
                    {   "lowerBound": 0,
                        "upperBound": 50000
                    },
                    "measures": [],
                    "thresholds": [],
                    "timeSeriesQuery": 
                    {   "outputFullDuration": true,
                        "timeSeriesFilter": 
                        {   "aggregation": 
                            {   "alignmentPeriod": "86400s",
                                "crossSeriesReducer": "REDUCE_SUM",
                                "groupByFields": [],
                                "perSeriesAligner": "ALIGN_SUM"
                            },
                            "filter": "metric.type=\"logging.googleapis.com/user/operations_gcs_fablefacet\" metric.label.\"operation_class\"=\"CLASS_B\" metric.label.\"month\"=\"2606\""
                        },
                        "unitOverride": ""
                    }
                }
            }
        },{
            "yPos": 16,
            "height": 16,
            "width": 16,
            "widget": 
            {   "title": "FF storage - Free Tier Limit is 5GiB {date_placeholder}",
                "scorecard": 
                {   "gaugeView": 
                    {   "lowerBound": 0,
                        "upperBound": 1
                    },
                    "thresholds": [],
                    "timeSeriesQuery": 
                    {   "outputFullDuration": true,
                        "timeSeriesFilter": 
                        {   "aggregation": 
                            {   "alignmentPeriod": "86400s",
                                "crossSeriesReducer": "REDUCE_SUM",
                                "groupByFields": [],
                                "perSeriesAligner": "ALIGN_NEXT_OLDER"
                            },
                            "filter": "metric.type=\"storage.googleapis.com/storage/total_bytes\" resource.type=\"gcs_bucket\" resource.label.\"bucket_name\"=\"{bucket_name}\""
                        }
                    }
                }
            }
        },{
            "yPos": 16,
            "xPos": 16,
            "height": 16,
            "width": 17,
            "widget": 
            {   "title": "Feel free to change or delete this dashboard",
                "text": 
                {   "content": "Fable Facet site queries the underlying data source to obtain the results in the site, so this dashboard is just for your convenience (and for you to see that it is Google that is reporting the values). \r\n\r\nChanging or deleting it will have no effect on the site, but it will not revert back to this configuration or be recreated automatically.",
                    "format": "MARKDOWN",
                    "style":
                    {   "backgroundColor": "#FFFFFF",
                        "fontSize": "FS_LARGE",
                        "horizontalAlignment": "H_LEFT",
                        "padding": "P_EXTRA_SMALL",
                        "pointerLocation": "POINTER_LOCATION_UNSPECIFIED",
                        "textColor": "#212121",
                        "verticalAlignment": "V_TOP"
                    }
                }
            }
        }]
    }
}
